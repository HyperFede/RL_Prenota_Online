# Copy to deploy/.env on the NAS (not committed).
# Folder with data/, secrets/ and tailscale/ (created by `manage init`), e.g. inside "Fede private"
RLP_HOME=/share/CACHEDEV1_DATA/<Fede private>/RL_Prenota_Online
# Public HTTPS origin given by Tailscale Funnel (no path)
RLP_PUBLIC_ORIGIN=https://rl-prenota.<your-tailnet>.ts.net
# Username of the dedicated bot created with @BotFather (without @)
RLP_BOT_USERNAME=RLPrenotaBot
# Numeric uid/gid of the NAS user that owns RLP_HOME (`id -u` / `id -g` over SSH)
RLP_UID=1000
RLP_GID=100
